<?xml version="1.0" encoding="utf-8"?>
<!--
  ホーム画面ウィジェット「ライブ tail」のレイアウト (TailWidgetProvider)。
  本文はファイルの行の一覧で、中でスクロールする。1 行は widget_tail_item.xml。

  ⚠ id は「ウィジェットの約束の表」で決めてある。一覧は 2 つ必須:
   - tail_list_end   … 末尾 (tail) 用。stackFromBottom="true" と transcriptMode="alwaysScroll" を
                        外さないこと (開いた時点で最新の行が見えるのはこの 2 つのおかげ)。
   - tail_list_start … 先頭 (head) 用。こちらには付けない。
  2 つは同じ場所に重ね、コードが片方だけを見せる。tail_empty は案内・空表示用の TextView。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- ヘッダー行 (ファイルパス + ⚙ 設定 + ⟳ 更新) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 見ているファイル (~ からのパス)。タップでアプリを開く。 -->
        <TextView
            android:id="@+id/tail_title"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_text_title"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="start" />

        <ImageView
            android:id="@+id/tail_config"
            style="@style/Z2WidgetIconButton"
            android:src="@drawable/ic_widget_settings"
            android:contentDescription="@string/tail_config_btn_desc" />

        <ImageView
            android:id="@+id/tail_refresh"
            style="@style/Z2WidgetIconButton"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@string/widget_refresh_desc" />
    </LinearLayout>

    <!-- ログ表示パネル -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_button"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <ListView
            android:id="@+id/tail_list_end"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:scrollbars="none"
            android:stackFromBottom="true"
            android:transcriptMode="alwaysScroll" />

        <ListView
            android:id="@+id/tail_list_start"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:scrollbars="none"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tail_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_desc"
            android:visibility="gone" />
    </FrameLayout>

    <!-- フッター (モード · 時点 · ファイルサイズ) -->
    <TextView
        android:id="@+id/tail_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="@dimen/widget_text_footer"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
