<?xml version="1.0" encoding="utf-8"?>
<!--
  マクロウィジェット (マス目型 widget_status.xml / 一覧型 widget_list.xml) の上段。
  両方から <include> する。

  1.0.56: ssh の接続コマンドは**横幅いっぱいの 1 行**に置く。1.0.55 は常駐・自動化・電池と
  横に並べたため幅が 4 割ほどしかなく、「ssh -p 6…」で切れてポート番号から先が読めなかった。
  コマンド自体が ssh で始まるので見出し (widget_ssh_label) は出さない (id は約束の表どおり残す)。

  ⚠ id は「ウィジェットの約束の表」で決めてある (コードが id で値を入れる)。
  見た目・並び・余白は自由に変えてよいが、id を消す・変える・別の種類の View にすることはしない。
  RemoteViews で使える View だけを使うこと (表の「使える部品」参照)。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- タイトル行 (アプリ名 + ⚙ 設定 + ⟳ 更新) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- タップでアプリを開く -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_text_title"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/widget_config"
            style="@style/Z2WidgetIconButton"
            android:src="@drawable/ic_widget_settings"
            android:contentDescription="@string/widget_config_btn_desc" />

        <ImageView
            android:id="@+id/widget_refresh"
            style="@style/Z2WidgetIconButton"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@string/widget_refresh_desc" />
    </LinearLayout>

    <!-- ssh の接続コマンド (横幅いっぱい。sshd が動いているときだけアクセント色) -->
    <TextView
        android:id="@+id/widget_ssh_label"
        style="@style/Z2WidgetLabel"
        android:text="@string/widget_label_ssh"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_ssh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_secondary"
        android:textSize="@dimen/widget_text_value"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- 常駐 / 自動化 / 電池 (見出しと値を横に並べた 3 つ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_servers_label"
                style="@style/Z2WidgetLabel"
                android:text="@string/widget_label_servers" />
            <TextView
                android:id="@+id/widget_servers"
                style="@style/Z2WidgetValue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_rules_label"
                style="@style/Z2WidgetLabel"
                android:text="@string/widget_label_rules" />
            <TextView
                android:id="@+id/widget_rules"
                style="@style/Z2WidgetValue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_battery_label"
                style="@style/Z2WidgetLabel"
                android:text="@string/widget_label_battery" />
            <TextView
                android:id="@+id/widget_battery"
                style="@style/Z2WidgetValue" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
