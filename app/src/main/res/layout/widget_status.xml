<?xml version="1.0" encoding="utf-8"?>
<!--
  ホーム画面ウィジェット「状態＋マクロ (マス目)」のレイアウト (StatusWidgetProvider)。
  上段は widget_status_header.xml、下段はマクロ 4 個のマス (2×2)。

  ⚠ id は「ウィジェットの約束の表」で決めてある。マスは 4 個 (widget_tile_0〜3) と
  それを包む 2 行 (widget_tiles_row_0 / _1) が必須。マスの背景はコードが状態ごとに
  widget_tile_* へ差し替えるので、マスの root (widget_tile_N) に背景を持たせる。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <include layout="@layout/widget_status_header" />

    <!-- マス目 1行目 (マス 0, 1) -->
    <LinearLayout
        android:id="@+id/widget_tiles_row_0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- マス 0 -->
        <LinearLayout
            android:id="@+id/widget_tile_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_idle"
            android:orientation="vertical"
            android:padding="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_tile_0_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
                <ImageView
                    android:id="@+id/widget_tile_0_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_run" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tile_0_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_text_desc"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_tile_0_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_state_idle"
                    android:textSize="@dimen/widget_text_state"
                    android:fontFamily="monospace"
                    android:singleLine="true" />
                <Chronometer
                    android:id="@+id/widget_tile_0_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/widget_state_running"
                    android:textSize="@dimen/widget_text_state"
                    android:fontFamily="monospace"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- マス 1 -->
        <LinearLayout
            android:id="@+id/widget_tile_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_tile_idle"
            android:orientation="vertical"
            android:padding="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_tile_1_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
                <ImageView
                    android:id="@+id/widget_tile_1_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_run" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tile_1_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_text_desc"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_tile_1_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_state_idle"
                    android:textSize="@dimen/widget_text_state"
                    android:fontFamily="monospace"
                    android:singleLine="true" />
                <Chronometer
                    android:id="@+id/widget_tile_1_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/widget_state_running"
                    android:textSize="@dimen/widget_text_state"
                    android:fontFamily="monospace"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- マス目 2行目 (マス 2, 3。マクロが 3 個未満のとき GONE) -->
    <LinearLayout
        android:id="@+id/widget_tiles_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- マス 2 -->
        <LinearLayout
            android:id="@+id/widget_tile_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_idle"
            android:orientation="vertical"
            android:padding="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_tile_2_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
                <ImageView
                    android:id="@+id/widget_tile_2_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_run" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tile_2_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_text_desc"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_tile_2_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_state_idle"
                    android:textSize="@dimen/widget_text_state"
                    android:fontFamily="monospace"
                    android:singleLine="true" />
                <Chronometer
                    android:id="@+id/widget_tile_2_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/widget_state_running"
                    android:textSize="@dimen/widget_text_state"
                    android:fontFamily="monospace"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- マス 3 -->
        <LinearLayout
            android:id="@+id/widget_tile_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_tile_idle"
            android:orientation="vertical"
            android:padding="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_tile_3_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="@dimen/widget_text_name"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
                <ImageView
                    android:id="@+id/widget_tile_3_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_run" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tile_3_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_text_desc"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/widget_tile_3_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_state_idle"
                    android:textSize="@dimen/widget_text_state"
                    android:fontFamily="monospace"
                    android:singleLine="true" />
                <Chronometer
                    android:id="@+id/widget_tile_3_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/widget_state_running"
                    android:textSize="@dimen/widget_text_state"
                    android:fontFamily="monospace"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- フッター (更新時刻 / 最後に終わったマクロ) -->
    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="@dimen/widget_text_footer"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
