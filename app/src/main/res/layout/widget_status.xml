<?xml version="1.0" encoding="utf-8"?>
<!--
  ホーム画面ウィジェット D1「状態＋ランチャー」のレイアウト。

  RemoteViews で描くので Compose は使えず、ここで使える View も限られる
  (LinearLayout / TextView など)。マクロボタンは可変個だが RemoteViews では
  View を動的に生やせないため、4 個ぶんを置いておき、余った枠を GONE にする
  (com.zerotoship.z2term.widget.StatusWidgetProvider)。

  0.8.216 の作り直し (実機フィードバック):
   - ボタン行に layout_weight=1 を持たせて**余った高さを吸わせる**。以前は全段が
     wrap_content だったので、ウィジェットの枠が中身より高いと下に大きな空白が残り、
     同時にボタンが小さくて押しにくかった。
   - ⟳ と ⚙ を 40dp 角のタップ領域にする (以前の ⟳ は 14sp の文字だけで押せなかった)。
   - ボタンは 2 行 (名前 / 開始時刻) にして、複数走らせても取り違えないようにする。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_config"
            style="@style/Z2WidgetIconButton"
            android:layout_marginStart="6dp"
            android:text="@string/widget_config_glyph"
            android:contentDescription="@string/widget_config_btn_desc" />

        <TextView
            android:id="@+id/widget_refresh"
            style="@style/Z2WidgetIconButton"
            android:layout_marginStart="6dp"
            android:text="@string/widget_refresh_glyph"
            android:contentDescription="@string/widget_refresh_desc" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_ssh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- weight=1 で残りの高さを全部もらう。ボタンが縦に伸びて押しやすくなり、
         同時にウィジェット下端の余白が消える。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_0"
            style="@style/Z2WidgetButton" />

        <TextView
            android:id="@+id/widget_btn_1"
            style="@style/Z2WidgetButton"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/widget_btn_2"
            style="@style/Z2WidgetButton"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/widget_btn_3"
            style="@style/Z2WidgetButton"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
