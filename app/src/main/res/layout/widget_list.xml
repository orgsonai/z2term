<?xml version="1.0" encoding="utf-8"?>
<!--
  ホーム画面ウィジェット「状態＋マクロ (一覧)」のレイアウト (MacroListWidgetProvider)。
  上段は widget_status_header.xml、下段はマクロの一覧 (中でスクロール)。1 行は widget_macro_item.xml。

  ⚠ id は「ウィジェットの約束の表」で決めてある。widget_list は ListView のまま
  (GridView / StackView にしない)、widget_list_empty はマクロが無いときに出す TextView。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <include layout="@layout/widget_status_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp">

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/widget_border"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/widget_list_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_desc"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="@dimen/widget_text_footer"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
