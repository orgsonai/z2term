<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="qr_tools_title">QR 도구</string>
    <string name="qr_tools_close">닫기</string>
    <string name="qr_tools_camera">카메라로 읽기</string>
    <string name="qr_tools_image">이미지에서 읽기</string>
    <string name="qr_tools_cancel">취소</string>
    <string name="qr_tools_content">QR 내용 / 변환할 텍스트</string>
    <string name="qr_tools_intro">카메라나 이미지로 읽습니다. 내용을 확인한 후 작업을 선택하세요.</string>
    <string name="qr_tools_copy">복사</string>
    <string name="qr_tools_show">QR 표시</string>
    <string name="qr_tools_open_url">브라우저에서 URL 열기</string>
    <string name="qr_tools_save_ssh">SSH 연결 저장</string>
    <string name="qr_tools_ssh_note">호스트, 포트, 사용자 이름만 포함합니다. 연결 편집에서 인증을 설정하고 연결할 때 호스트 키를 확인합니다.</string>
    <string name="qr_tools_name">이름 (선택)</string>
    <string name="qr_tools_insert">터미널 입력란에 넣기</string>
    <string name="qr_tools_save_command">명령 목록에 저장</string>
    <string name="qr_tools_save_edge">엣지 버튼으로 추가</string>
    <string name="qr_tools_command_qr">명령 QR 만들기</string>
    <string name="qr_tools_command_note">읽거나 저장해도 실행하지 않습니다. 엣지 버튼은 새 비활성 패널에 추가됩니다. 패널 관리에서 표시하세요.</string>
    <string name="qr_tools_multiline">줄바꿈이나 제어 문자가 있는 내용은 복사할 수 있지만 명령으로 입력하지 않습니다.</string>
    <string name="qr_tools_done">저장했습니다</string>
    <string name="qr_tools_failed">작업하지 못했습니다. QR 내용, 이미지, 카메라 권한 또는 저장 위치를 확인하세요.</string>
    <string name="qr_tools_qr_limit">UTF-8 기준 최대 2,000바이트입니다. 표시되지 않으면 내용을 줄이세요.</string>
    <string name="qr_tools_oss">오프라인 QR 생성 및 카메라·이미지 읽기</string>
    <string name="direct_share_title">이 기기에서 파일 공유</string>
    <string name="direct_share_origin">공개 URL (경로 제외)</string>
    <string name="direct_share_port">이 기기의 수신 포트</string>
    <string name="direct_share_intro">선택한 파일 또는 폴더를 이 기기에서 직접 공유합니다. 수신자는 브라우저에서 QR이나 링크를 열고 폴더를 탐색한 뒤 필요한 파일을 확인하여 저장합니다. 중계 서비스나 클라우드 업로드는 사용하지 않습니다.</string>
    <string name="direct_share_network">인터넷에서 접근할 주소와 수신 허용 또는 포트 전달이 필요합니다. 공유 시작만으로 모바일 회선 제한은 해제되지 않습니다. IPv6 전용 URL은 상대도 IPv6가 필요합니다.</string>
    <string name="direct_share_duration">공유 기간</string>
    <string name="direct_share_minutes">%1$d분</string>
    <string name="direct_share_certificate">HTTPS 인증서 선택 (.p12/.pfx)</string>
    <string name="direct_share_certificate_selected">인증서 선택됨 — 변경</string>
    <string name="direct_share_password">인증서 암호</string>
    <string name="direct_share_tls_note">공개 호스트와 일치하고 브라우저가 신뢰하는 인증서·개인 키·체인이 든 PKCS#12를 선택하세요. 암호는 저장하지 않습니다.</string>
    <string name="direct_share_http_note">HTTP가 파일과 공유 URL을 암호화하지 않음을 이해합니다.</string>
    <string name="direct_share_choose">파일 선택</string>
    <string name="direct_share_start">공유 시작·QR 표시</string>
    <string name="direct_share_stop">공유 중지</string>
    <string name="direct_share_preparing">파일 준비 중…</string>
    <string name="direct_share_notification">공유 중입니다. 눌러 열거나 중지하세요.</string>
    <string name="direct_share_send_link">링크 공유</string>
    <string name="direct_share_unverified">대기 중입니다. 외부 접속은 미확인입니다. 다른 회선에서 열리는지 확인하세요.</string>
    <string name="direct_share_visited">수신 페이지에 접속했습니다. 모든 회선에서 접속된다는 뜻은 아닙니다.</string>
    <string name="direct_share_expires">%1$s에 공유 종료</string>
    <string name="direct_share_bytes">전송량(재시도 포함): %1$s. 저장 완료는 수신 기기에서 확인하세요.</string>
    <string name="direct_share_failed">공유를 시작할 수 없습니다. URL, 포트, 파일이나 폴더 접근 권한, 여유 공간 및 HTTPS 인증서를 확인하세요. 제한: 총 1 GiB, 항목 10,000개, 깊이 64단계.</string>
    <string name="direct_share_lifetime">수신이 끝날 때까지 이 기기를 온라인 상태로 유지하세요. 설정한 기간에는 링크를 아는 사람이 수신할 수 있습니다. 중지, 만료 또는 연결 변경 시 공유 서버와 진행 중인 전송을 종료하고 전송용 복사본을 삭제합니다. 다른 서버는 중지하지 않습니다.</string>
    <string name="direct_share_stopping">공유를 중지하는 중…</string>
    <string name="qr_tools_incoming_failed">공유된 QR 내용을 읽지 못했습니다. QR이 담긴 읽을 수 있는 이미지(최대 8장) 또는 4,096자 이내의 텍스트를 공유하세요.</string>
    <string name="direct_share_mode_auto">자동</string>
    <string name="direct_share_mode_manual">수동</string>
    <string name="direct_share_auto_note">현재 Wi-Fi 또는 모바일 연결을 사용합니다. 파일이나 폴더를 선택하면 기기 주소와 사용 가능한 포트로 서버를 시작하고 URL과 QR을 표시합니다. 네트워크나 라우터에서 외부 연결을 허용해야 합니다.</string>
    <string name="direct_share_auto_http">자동 공유는 HTTP를 사용합니다. 파일과 공유 URL은 암호화되지 않습니다. HTTPS는 수동 모드에서 설정하세요.</string>
    <string name="direct_share_choose_start">파일 선택 후 공유 시작</string>
    <string name="direct_share_no_public_address">현재 연결에서 공개 주소를 자동으로 가져올 수 없습니다. 연결을 변경하거나 공개 주소와 포트 전달을 설정했다면 수동 모드를 사용하세요.</string>
    <string name="direct_share_network_changed">연결 또는 주소가 변경되어 공유와 공유 서버를 중지했습니다. 파일이나 폴더를 다시 선택하면 새 URL로 공유할 수 있습니다.</string>
    <string name="direct_share_ipv6">IPv6 URL입니다. 수신자도 IPv6 연결이 필요합니다.</string>
    <string name="direct_share_choose_folder">폴더 선택</string>
    <string name="direct_share_choose_folder_start">폴더 선택 후 공유 시작</string>
    <string name="direct_share_folder_note">폴더 구조를 유지합니다. 수신자는 브라우저에서 폴더를 열고 필요한 파일을 개별적으로 받을 수 있습니다.</string>
    <string name="direct_share_selected_folder">%1$s (폴더)</string>
    <string name="direct_share_preparing_folder">폴더 목록과 파일을 준비하는 중…</string>
    <string name="direct_share_folder_summary">파일 %1$d개 · 총 %2$s</string>
</resources>
