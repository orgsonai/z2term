<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 案内の片付け (1.0.6)。Guide.cleanup -->
    <string name="settings_guide_cleanup">정리</string>
    <string name="settings_guides_cleanup_desc">\"정리\"를 누르면 그 안내로 추가한 것을 지우는 절차가 같은 카드로 나옵니다. 카드를 누르기 전에는 아무것도 지워지지 않습니다.</string>
    <string name="guide_cleanup_heading">추가한 것 정리</string>
    <string name="guide_cleanup_hint">누르면 실행 (먼저 Ctrl-C를 보내 쓰다 만 줄이 섞이지 않게 합니다) / 남길 것은 ✕</string>
    <string name="guide_undo_rules">이 매크로를 부르는 자동화 규칙 지우기</string>
    <string name="guide_undo_macro">매크로 지우기 (직접 고쳤다면 지우지 않고 멈춥니다)</string>
    <string name="guide_undo_notify_off">다른 곳에서 쓰지 않는다면: 설정 -> \"알림 감지\" 끄기</string>
    <string name="guide_undo_sms_off">다른 곳에서 쓰지 않는다면: 설정 -> \"SMS 감지\" 끄기</string>
    <string name="guide_undo_remind_all">등록한 알림을 모두 취소하기</string>
    <string name="guide_undo_remind_tiles">remind.sh를 넣은 타일 칸 비우기</string>
    <string name="guide_undo_remind_data">알림 기록 지우기 (남기려면 ✕)</string>
    <string name="guide_undo_rss_data">피드 목록과 모은 글 지우기 (남기려면 ✕)</string>
    <string name="guide_undo_edge_main">예제 앱 목록 패널 main 지우기 (직접 추가한 항목도 함께 지워집니다)</string>
    <string name="guide_undo_edge_samples">예제 패널 지우기 (메모장의 글도 지워집니다)</string>
    <string name="guide_undo_edge_off">다른 패널을 쓰지 않는다면 패널 끄기 (바가 사라집니다)</string>
    <string name="guide_undo_permissions">\"다른 앱 위에 표시\"와 접근성 허용은 Android 설정에서만 끌 수 있습니다. 다른 기능에서 쓰고 있다면 그대로 두세요.</string>
</resources>
