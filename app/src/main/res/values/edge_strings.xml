    <string name="edge_recreate_tab_help">Recreate the selected tab. Create its parent if missing; otherwise keep other tabs and append this tab. An existing tab keeps its position.</string>
    <string name="edge_recreate_files_help">Matching IDs receive added or updated settings. Existing items and unspecified settings are kept. Unsaved edits, note contents, referenced scripts and images are not included. Back up those files separately.</string>
