    <string name="edge_scroll_fixed">Fixed speed</string>
    <string name="edge_scroll_range">Slide distance to maximum speed (dp)</string>
    <string name="edge_scroll_range_help" formatted="false">32–2000dp (default 160). A larger value requires a longer slide to reach maximum speed. Variable speed only. At 640dp, a 160dp slide gives 25% of maximum speed.</string>
    <string name="edge_scroll_speed">Maximum / fixed speed (dp/s)</string>
