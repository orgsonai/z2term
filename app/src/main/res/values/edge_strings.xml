    <string name="edge_bar_color_help">Automatic switches between white and black using the background. Requires Android 11 or later and z2term Android actions accessibility. A contrasting outline remains when sampling is unavailable. Fixed white or black does not capture screen images.</string>
    <string name="edge_note_background">Note background colour</string>
    <string name="edge_note_color">Note text colour</string>
    <string name="edge_note_colors_help">Choose a swatch or enter #RRGGBB. Automatic uses the theme background and adapts the text to the background. Changes apply when saved.</string>
    <string name="edge_color_invalid">Enter #RRGGBB, for example #FFFFFF.</string>
    <string name="edge_button_state">Show ON/OFF</string>
    <string name="edge_button_state_desc">ON uses the button border and background. Automatic follows supported device features, including changes made elsewhere. For a timed macro, select ON while running; OFF on exit. A state command takes priority; detached background tasks need a state query.</string>
