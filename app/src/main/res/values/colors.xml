<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      XML リソースとして要るのは themes.xml が参照する背景色だけ。
      UI 配色（アクセント / テキスト / ステータス）は Compose 側の Color 定数、
      ターミナルの ANSI 16 色は emulator 側の配色テーブルが持つ。
      XML に写しを置くと二重管理になり、片方だけ直して食い違うので置かない。
    -->
    <color name="zts_bg_primary">#0a0a0a</color>
</resources>
