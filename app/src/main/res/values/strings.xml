    <string name="settings_section_language">Language / 言語</string>
    <string name="settings_section_language_desc">Switches the in-app display language (independent of the OS setting). When English is selected, untranslated parts remain in Japanese (more translation coming). The Japanese flick keyboard is hidden in English mode.</string>
