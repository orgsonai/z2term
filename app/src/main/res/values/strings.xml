    <string name="settings_section_keyboard_style">Keyboard style</string>
    <string name="settings_keyboard_toggle_bar">Keyboard toggle bar</string>
    <string name="settings_keyboard_toggle_bar_desc">Show a show/hide bar above the keyboard. When off, double-tap the ⌨ button to toggle.</string>
    <string name="settings_section_gui_terminal">GUI terminal</string>
    <string name="settings_gui_magnification">GUI magnification (applies from next GUI start)</string>
    <string name="settings_clean_install">Clean install</string>
    <string name="settings_gui_audio">GUI audio</string>
    <string name="settings_gui_audio_desc">ON: play sound from GUI apps on this device. PulseAudio is installed into the Linux side on first use (downloads a few MB). OFF: no audio, no extra packages.</string>
    <string name="settings_ambiguous_width">Treat ambiguous-width chars as 2 cells</string>
    <string name="settings_ambiguous_width_desc">For CJK locales (works for PowerLine glyphs etc.)</string>
    <string name="settings_keep_alive">Background service</string>
    <string name="settings_keep_alive_desc">ON: keep the session alive after closing the app (a notification appears). OFF: terminate when closed.</string>
    <string name="settings_confirm_download">Confirm before download</string>
    <string name="settings_confirm_download_desc">ON: prompt before downloading a distro or GUI package. OFF: download without confirmation.</string>
    <string name="settings_section_process_guard">Background process protection</string>
    <string name="settings_battery_opt_toggle">Exclude from battery optimization</string>
    <string name="settings_battery_opt_toggle_desc">ON: the OS is less likely to kill the session and its running processes in the background. Turning OFF opens system settings (Android does not allow apps to re-enable optimization directly).</string>
    <string name="settings_phantom_title">If processes still get killed (Android 12/13)</string>
    <string name="settings_phantom_desc">Android 12/13 may kill the \"phantom processes\" that proot spawns. This cannot be changed inside the app — run the following from a PC via adb, then reboot the device. Android 14+ is usually relaxed already.</string>
    <string name="settings_phantom_copy">Copy adb command</string>
    <string name="settings_phantom_copied">Copied the adb command</string>
    <string name="settings_section_landscape_keyboard">Keyboard position (landscape)</string>
    <string name="settings_landscape_keyboard_desc">Where to place the on-screen keyboard when the screen is in landscape. Portrait always uses Bottom.</string>
