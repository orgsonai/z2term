<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="permissions_intro">在此設定各功能所需的權限。權限與通知偵測、日誌儲存可分別設定。</string>
    <string name="permissions_open_failed">無法開啟權限設定。</string>
    <string name="permissions_notifications">顯示通知</string>
    <string name="permissions_notifications_desc">顯示常駐服務及指令傳送的通知。可在Android中依通知類別設定。</string>
    <string name="permissions_listener">讀取通知</string>
    <string name="permissions_listener_desc">讀取其他應用程式的通知，用於日誌和自動化規則。</string>
    <string name="permissions_accessibility">無障礙</string>
    <string name="permissions_accessibility_desc">用於取得座標、點選、滑動等Android操作。</string>
    <string name="permissions_overlay">顯示在其他應用程式上層</string>
    <string name="permissions_overlay_desc">在其他應用程式上方顯示浮動面板和工具。</string>
    <string name="permissions_storage">共用儲存空間</string>
    <string name="permissions_storage_desc">讀寫/sdcard等共用儲存空間。檔案選擇器中指定的資料夾需分別授權。</string>
    <string name="permissions_sms">接收簡訊</string>
    <string name="permissions_sms_desc">讀取收到的簡訊，用於簡訊日誌和自動化規則。</string>
    <string name="permissions_battery">忽略電池最佳化</string>
    <string name="permissions_battery_desc">讓背景服務在螢幕關閉時更容易繼續執行。</string>
    <string name="permissions_write_settings">修改系統設定</string>
    <string name="permissions_write_settings_desc">在指定時段內調整螢幕自動關閉時間。</string>
    <string name="permissions_usage">使用情況存取權</string>
    <string name="permissions_usage_desc">讀取裝置流量，以判斷是否達到設定的流量上限。</string>
    <string name="permissions_install">安裝應用程式更新</string>
    <string name="permissions_install_desc">允許此應用程式將下載的APK交給Android安裝程式。</string>
    <string name="permissions_admin">裝置管理員</string>
    <string name="permissions_admin_desc">偵測螢幕解鎖的失敗與成功。不用於遠端鎖定或清除資料。</string>
    <string name="permissions_ime">啟用鍵盤</string>
    <string name="permissions_ime_desc">將內建鍵盤啟用為Android輸入法。</string>
    <string name="permissions_usb">USB裝置</string>
    <string name="permissions_usb_desc">連接裝置後逐一授權。權限在中斷連線前有效。</string>
    <string name="permissions_usb_empty">沒有已連接的USB裝置。</string>
    <string name="permissions_root">root存取</string>
    <string name="permissions_root_desc">僅在按下按鈕時要求root並檢查chroot支援。</string>
    <string name="permissions_root_checked">先前已通過檢查啟用chroot。可按按鈕重新檢查目前的root存取。</string>
    <string name="permissions_app_details">應用程式資訊</string>
    <string name="permissions_app_details_desc">管理應用程式權限與Android限制。權限要求視窗不再出現時，也可在此變更。</string>
    <string name="permissions_manage">開啟設定</string>
    <string name="permissions_request">要求權限</string>
    <string name="permissions_granted">已啟用／已允許</string>
    <string name="permissions_missing">未啟用／未允許</string>
    <string name="tools_automation_actions">操作自動化</string>
    <string name="tools_automation_rules">自動化規則</string>
    <string name="permissions_tab_access">權限</string>
    <string name="permissions_tab_logs">通知與日誌</string>
    <string name="permissions_log_missing">請在「權限」分頁中允許：%1$s</string>
</resources>
