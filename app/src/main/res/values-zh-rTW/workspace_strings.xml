    <string name="document_waiting">正在選取或複製文件…</string>
    <string name="process_text_title">用z2term處理</string>
    <string name="process_text_enable">用於處理所選文字</string>
    <string name="process_text_contract">將原文傳入所選命令的標準輸入。確認標準輸出後再取代。</string>
    <string name="process_text_setup">在命令清單 → 片段中註冊命令，並啟用「用於處理所選文字」。</string>
    <string name="process_text_replace">取代所選文字</string>
    <string name="process_text_too_large">支援不含NUL、最大64 KiB的文字。</string>
    <string name="workspace_title">工作階段配置</string>
    <string name="workspace_hint">選擇要放在目前分頁旁邊的分頁。所選分頁會加入目前分頁的群組（不超過群組上限）。輕觸窗格選擇輸入目標，拖曳分隔線調整大小。長按窗格標題並拖曳可移動該分頁。標題右端的按鈕（或輕觸兩下標題）只顯示該分頁，再按一次返回群組排列。</string>
    <string name="workspace_vertical">上下</string>
    <string name="workspace_horizontal">左右</string>
    <string name="workspace_preview_current">目前分頁</string>
    <string name="workspace_preview_other">下面點選的分頁</string>
    <string name="workspace_need_two">請先再開啟一個終端或GUI分頁。</string>
    <string name="workspace_maximize">僅顯示此分頁</string>
    <string name="workspace_single">返回單窗格</string>
    <string name="workspace_external_hint">將目前分頁顯示在外接螢幕上。手機可控制該分頁或顯示其他分頁。</string>
    <string name="workspace_no_display">沒有可用的外接螢幕。</string>
    <string name="workspace_return">返回手機</string>
    <string name="workspace_projected">正在外接螢幕上顯示。鍵盤控制該工作階段。</string>
    <string name="workspace_controller">外接螢幕：此區域可作觸控板，下方鍵盤可用於輸入。</string>
    <string name="workspace_display_failed">無法使用此螢幕。工作階段仍在執行。</string>
    <string name="settings_gui_direct">直接顯示本機 GUI（實驗功能）</string>
    <string name="settings_gui_direct_desc">直接讀取本機幀緩衝。首次使用時安裝 Xvfb 和僅用於輸入的 x11vnc。適用於新建 GUI 分頁。解析度在啟動時固定，無 GPU 加速。</string>
    <string name="tip_gui_split_title">長按 GUI 按鈕分割 GUI/CUI</string>
    <string name="tip_gui_split_body">長按 + 旁的 GUI（🖥）按鈕開啟工作階段配置。選擇上下或左右排列，再選擇另一個分頁，即可同時使用 GUI 和終端機（CUI）。同一選單也可恢復單一畫面或選擇外部顯示器。短按仍會開啟 GUI。</string>
    <string name="group_default_name">群組 %1$d</string>
    <string name="group_full">一個群組最多可容納 %1$d 個分頁。</string>
    <string name="group_apply_direction">依此方向重新排列</string>
    <string name="group_edit">編輯群組…</string>
    <string name="group_restore">返回群組排列</string>
    <string name="group_rename_tab">重新命名</string>
    <string name="group_rename_group">重新命名群組</string>
    <string name="group_add_to">加入群組…</string>
    <string name="group_leave">移出群組</string>
    <string name="group_close_tab">關閉分頁</string>
    <string name="group_ungroup">解散群組</string>
    <string name="group_arrange_vertical">上下排列</string>
    <string name="group_arrange_horizontal">左右排列</string>
    <string name="group_delete">刪除群組</string>
    <string name="group_new">＋ 新增群組</string>
    <string name="group_new_tab">＋ 新增分頁</string>
    <string name="group_editor_title">編輯群組</string>
    <string name="group_editor_groups">群組</string>
    <string name="group_editor_tabs">分頁</string>
    <string name="group_editor_hint">輕觸右側的分頁，即可放入綠色框的群組。輕觸群組內的分頁可將其移回右側。長按並拖曳可調整順序，不移動直接放開可重新命名。</string>
    <string name="group_editor_empty">輕觸右側的分頁以加入</string>
    <string name="group_editor_all_grouped">所有分頁都已在群組中。</string>
    <string name="group_editor_close">關閉</string>
    <string name="group_editor_show">顯示此群組</string>
    <string name="group_choose_title">加入群組</string>
    <string name="group_count">%1$d 個分頁</string>
    <string name="group_name_title_tab">分頁名稱</string>
    <string name="group_name_title_group">群組名稱</string>
    <string name="settings_group_max_tabs">每個群組的分頁上限</string>
    <string name="settings_group_max_tabs_desc">一個群組可容納的分頁數量。此螢幕最多可選 %1$d 個（鍵盤開啟時每個窗格至少保留 4 行）。</string>
    <string name="tip_tab_menu_title">長按分頁後放開即可開啟選單</string>
    <string name="tip_tab_menu_body">可以重新命名分頁、加入或移出群組。選擇群組後，其中的分頁會上下排列，輕觸窗格即可在其中輸入。「編輯群組…」可在一個畫面中整理所有群組與分頁。</string>
    <string name="broadcast_paste_targets">傳送到 %1$d 個分頁</string>
    <string name="broadcast_include">傳送到 %1$s</string>
    <string name="broadcast_start">以此開始</string>
    <string name="broadcast_editor_hint">選擇要廣播的群組，然後輕觸「以此開始」。其中的終端分頁都會被勾選。</string>
    <string name="broadcast_on">📡 開 ·%1$d</string>
    <string name="broadcast_off">📡 關</string>
    <string name="broadcast_toggle">開啟或關閉廣播</string>
    <string name="broadcast_stop">📡 結束</string>
    <string name="broadcast_entry">📡 廣播</string>
    <string name="settings_broadcast_start_on">廣播開始時為「開」</string>
    <string name="settings_broadcast_start_on_desc">關閉（預設）時廣播以「關」開始，可先確認醒目標示的窗格再傳送。</string>
    <string name="tip_broadcast_title">將 ＋ / 🖥 向左滑動即可廣播</string>
    <string name="tip_broadcast_body">會出現 📡 按鈕。選擇群組並輕觸「以此開始」後，在已勾選的分頁中輸入的內容會傳送到該群組所有已勾選的分頁。廣播期間分頁列會一直顯示 📡 開關，輕觸切換開 / 關，長按可重新整理群組。接收輸入的窗格有警告色（主題的黃色）外框。再次滑動即可結束。</string>
    <string name="tip_tab_pinch_title">在分頁列上雙指縮放，一次調整所有分頁的寬度</string>
    <string name="tip_tab_pinch_body">在分頁列上張開兩指可顯示較長的分頁與群組名稱，捏合則能放下更多分頁。所有分頁一起變化，寬度下次開啟時仍會保留。</string>
    <string name="broadcast_start_button">📡 開始廣播</string>
</resources>
