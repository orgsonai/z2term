    <!-- 裏機能: 実行エンジン選択 (バージョン7回タップで解放) -->
    <string name="settings_section_engine">実行エンジン</string>
    <string name="settings_engine_proot">PRoot (非 root)</string>
    <string name="settings_engine_z2root">z2root (既定・非 root)</string>
    <string name="settings_engine_chroot">chroot (root)</string>
    <string name="settings_engine_desc">z2root は非 root の自前 ptrace エンジンです。chroot は実 root でネイティブ実行し root 化端末が必要です。新しいタブから選択中のエンジンで起動します。</string>
