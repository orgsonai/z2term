    <!-- 裏機能: 実行エンジン選択 (バージョン7回タップで解放) -->
    <string name="settings_section_engine">実行エンジン</string>
    <string name="settings_engine_proot">PRoot (非 root)</string>
    <string name="settings_engine_z2root">z2root (既定・非 root)</string>
    <string name="settings_engine_chroot">chroot (root)</string>
    <string name="settings_engine_desc">z2root は非 root の自前 ptrace エンジンです。chroot は実 root でネイティブ実行し root 化端末が必要です。新しいタブから選択中のエンジンで起動します。</string>
    <string name="settings_engine_current">このタブの実エンジン</string>
    <string name="settings_engine_current_starting">起動中…</string>
    <string name="settings_trace_log_toggle">トレースログ (開発用)</string>
    <string name="settings_trace_log_toggle_desc">z2root の全 syscall を z2root_trace.log に記録します。</string>
    <string name="settings_trace_log_warning">⚠ 開発・障害調査用です。ON にするとログが膨大になり端末の空き容量をすぐ圧迫します。普段は OFF のままにしてください。</string>
    <string name="settings_engine_android_sh">Android sh (フォールバック)</string>
    <string name="tab_popup_engine_label">エンジン</string>
    <string name="tab_popup_engine_gui">GUI (Linux)</string>
    <string name="settings_engine_unlock_ok">エンジン選択を解放しました。下でエンジンを選べます。</string>
    <string name="settings_engine_lock_ok">エンジン選択を隠し、既定の PRoot に戻しました。</string>
    <string name="settings_root_unlock_ok">root を解放しました — chroot も選べます。</string>
    <string name="settings_root_unlock_failed">root 許可が得られませんでした。許可ダイアログが出ないときは、Magisk 等の root 管理アプリで Z2Term の root を「許可」に変えてから、もう一度このボタンを押してください（一度「拒否」すると Magisk が記憶し再表示しません）。</string>
    <string name="settings_root_chroot_blocked">root は使えますが chroot 実行に失敗しました（SELinux/rootfs 等の可能性）: %1$s</string>
    <string name="settings_root_retry_hint">chroot は root 端末で root を許可すると選べます。下のボタンで再確認できます。一度「拒否」した後はダイアログが出なくなるので、Magisk 等で Z2Term の root を「許可」に戻してから押してください。</string>
    <string name="settings_root_retry_button">chroot を有効化（root を確認）</string>
    <string name="settings_root_retry_probing">root を確認中…</string>
    <plurals name="settings_root_unlock_countdown">
        <item quantity="other">エンジン選択の切替まであと %1$d 回</item>
    </plurals>

