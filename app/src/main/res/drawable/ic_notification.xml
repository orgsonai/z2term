<?xml version="1.0" encoding="utf-8"?>
<!--
  ステータスバー常駐通知用アイコン (SAF プロバイダのルートアイコン・タイルにも使う)。

  通知アイコンは透過マスク (不透明部分が白系にティントされる) なので背景塗りは入れない。
  **色が使えない = 形でしか区別できない**ことに注意。

  `>_` (プロンプト + カーソル)。経緯:
   - 「Z2」の 2 文字 → ステータスバーの実表示 (24px 前後) では字が潰れて読めなかった
   - `>_` → 0.8.200 で「他の主要ターミナルアプリと同じシルエットになり見分けにくい」として
     いったん「Z」1 文字へ変えた
   - **0.8.511 で `>_` へ戻した (利用者の要望)**。ランチャーアイコンと同じ記号にして、
     ステータスバーでも「ターミナルの印」に見えることを優先する。見分けやすさより、
     何のアプリか一目で分かることを取った、という判断。

  ステータスバーでの実表示は 24px 前後しかないので、
   - 要素は 2 つだけ、細部を持たない
   - **塗りではなく線で描く** — 山括弧を塗りパスで作ると先端が痩せて潰れる。
     線幅 3.2 + 丸い端で、縮んでも太さが残るようにする
   - 端の余白を 4 前後空ける (OS 側のマスクに食われないように)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- > プロンプト -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5.5,6 L11,12 L5.5,18" />
    <!-- _ カーソル -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M13.5,18 L18.5,18" />
</vector>
