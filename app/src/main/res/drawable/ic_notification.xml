<?xml version="1.0" encoding="utf-8"?>
<!--
  ステータスバー常駐通知用アイコン (SAF プロバイダのルートアイコンにも使う)。

  通知アイコンは透過マスク (不透明部分が白系にティントされる) なので背景塗りは入れない。
  **色が使えない = 形でしか区別できない**ことに注意。

  「Z」1 文字 (0.8.200)。経緯:
   - 「Z2」の 2 文字 → ステータスバーの実表示 (24px 前後) では字が潰れて読めなかった
   - `>_` (プロンプト + カーソル) → ランチャーとは揃うが、**他の主要ターミナルアプリと
     同じシルエット**になり、通知を畳んだ状態でどちらのアプリか見分けられなかった
   - そこで通知だけ Z へ。斜めのストロークが主役なので山括弧 `>` と輪郭が根本的に違い、
     並んでも一目で区別できる。要素が 1 つだけなので小さい表示に強い。
     ランチャーアイコン (`>_`) は大きく表示されるので、そちらがターミナルらしさを担う。

  ステータスバーでの実表示は 24px 前後しかないので、
   - 要素は 1 つだけ、細部を持たない
   - 横棒の厚み 3.5 / 斜め帯も同等を確保して潰れないようにする
   - 端の余白を 4 前後空ける (OS 側のマスクに食われないように)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Z: 上バー → 斜め → 下バー を 1 本のパスで描く -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,4.5 L20,4.5 L20,8 L11.5,16 L20,16 L20,19.5 L4,19.5 L4,16 L12.5,8 L4,8 Z" />
</vector>
