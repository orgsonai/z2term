<?xml version="1.0" encoding="utf-8"?>
<!--
  ホーム画面ウィジェットの配色 (ライト・API 31+)。説明は values/widget_colors.xml。
  端末の配色 (壁紙から作られる system_* 色) を使うので、ほかのウィジェットと並べても浮かない。
  数字は明度 (1000 = 黒 … 10 = ほぼ白)。失敗だけは端末の配色に赤が無いので固定。
-->
<resources>
    <color name="widget_bg">@android:color/system_neutral1_50</color>
    <color name="widget_card">@android:color/system_accent2_100</color>
    <color name="widget_border">@android:color/system_neutral2_300</color>
    <color name="widget_running_bg">@android:color/system_accent1_100</color>
    <color name="widget_failed_bg">#FFF9DEDC</color>

    <color name="widget_accent">@android:color/system_accent1_600</color>
    <color name="widget_on_accent">@android:color/system_accent1_0</color>
    <color name="widget_text_primary">@android:color/system_neutral1_900</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_700</color>
    <color name="widget_text_tertiary">@android:color/system_neutral2_600</color>

    <color name="widget_state_idle">@android:color/system_neutral2_700</color>
    <color name="widget_state_running">@android:color/system_accent1_900</color>
    <color name="widget_state_done">@android:color/system_neutral2_700</color>
    <color name="widget_state_failed">#FFB3261E</color>
    <color name="widget_state_stopped">@android:color/system_neutral2_700</color>

    <color name="widget_log_text">@android:color/system_neutral1_900</color>
    <color name="widget_log_alert">#FFB3261E</color>
</resources>
