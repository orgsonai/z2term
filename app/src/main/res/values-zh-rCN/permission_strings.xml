<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="permissions_intro">在此设置各功能所需的权限。权限与通知检测、日志保存可分别设置。</string>
    <string name="permissions_open_failed">无法打开权限设置。</string>
    <string name="permissions_notifications">显示通知</string>
    <string name="permissions_notifications_desc">显示常驻服务及命令发送的通知。可在Android中按通知类别设置。</string>
    <string name="permissions_listener">读取通知</string>
    <string name="permissions_listener_desc">读取其他应用的通知，用于日志和自动化规则。</string>
    <string name="permissions_accessibility">无障碍</string>
    <string name="permissions_accessibility_desc">用于获取坐标、点击、滑动等Android操作。</string>
    <string name="permissions_overlay">显示在其他应用上层</string>
    <string name="permissions_overlay_desc">在其他应用上方显示悬浮面板和工具。</string>
    <string name="permissions_storage">共享存储</string>
    <string name="permissions_storage_desc">读写/sdcard等共享存储。文件选择器中指定的文件夹需分别授权。</string>
    <string name="permissions_sms">接收短信</string>
    <string name="permissions_sms_desc">读取收到的短信，用于短信日志和自动化规则。</string>
    <string name="permissions_battery">忽略电池优化</string>
    <string name="permissions_battery_desc">让后台服务在息屏时更容易继续运行。</string>
    <string name="permissions_write_settings">修改系统设置</string>
    <string name="permissions_write_settings_desc">在指定时段内调整屏幕自动关闭时间。</string>
    <string name="permissions_usage">使用情况访问权限</string>
    <string name="permissions_usage_desc">读取设备流量，以判断是否达到设定的流量上限。</string>
    <string name="permissions_install">安装应用更新</string>
    <string name="permissions_install_desc">允许此应用将下载的APK交给Android安装程序。</string>
    <string name="permissions_admin">设备管理器</string>
    <string name="permissions_admin_desc">检测屏幕解锁的失败与成功。不用于远程锁定或清除数据。</string>
    <string name="permissions_ime">启用键盘</string>
    <string name="permissions_ime_desc">将内置键盘启用为Android输入法。</string>
    <string name="permissions_usb">USB设备</string>
    <string name="permissions_usb_desc">连接设备后逐个授权。权限在断开连接前有效。</string>
    <string name="permissions_usb_empty">没有已连接的USB设备。</string>
    <string name="permissions_root">root访问</string>
    <string name="permissions_root_desc">仅在按下按钮时请求root并检查chroot支持。</string>
    <string name="permissions_root_checked">此前已通过检查启用chroot。可按按钮重新检查当前的root访问。</string>
    <string name="permissions_app_details">应用信息</string>
    <string name="permissions_app_details_desc">管理应用权限与Android限制。权限请求窗口不再出现时，也可在此更改。</string>
    <string name="permissions_manage">打开设置</string>
    <string name="permissions_request">请求权限</string>
    <string name="permissions_granted">已启用／已允许</string>
    <string name="permissions_missing">未启用／未允许</string>
    <string name="tools_automation_actions">操作自动化</string>
    <string name="tools_automation_rules">自动化规则</string>
