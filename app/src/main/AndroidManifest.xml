<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 必須権限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Service（M3 で本格利用、M1 では宣言のみ） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ で永続通知に必須 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- バックグラウンド維持強化（M3 で利用） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 電池最適化からの除外要求 (L1: バックグラウンドでの kill 頻度低減)。
         Play 非配布アプリのため直接要求を許容する。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android API ブリッジ: z2-vibrate 用 (通常権限・実行時要求不要) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 端末から /sdcard (Android 共有ストレージ) を cd/読み書きするため。
         Android 11+ は全ファイルアクセス、〜10 は従来権限で対応。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:name=".Z2TermApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Z2Term"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Z2Term">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M8-4 で正式タブ統合済 (タブバーの 🖥 ボタンで GUI タブを開く)。
             この単独 Activity は debug 専用の検証ツールとして残置 (release では
             onCreate で即 finish)。exported=false にして外部 (adb am start 含む) からは
             起動できないようにした。アプリ内部から起動する用途のみ。 -->
        <activity
            android:name=".gui.GuiActivity"
            android:exported="false"
            android:label="z2term GUI"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode"
            android:theme="@style/Theme.Z2Term" />

        <!-- Terminal Foreground Service: バックグラウンドで PTY を維持 -->
        <service
            android:name=".service.TerminalService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="terminal_session_persistence" />
        </service>

        <!-- SAF DocumentsProvider: rootfs / HOME を他のファイラーから開けるようにする。
             permission=MANAGE_DOCUMENTS でシステム (DocumentsUI) からのみアクセス可能。 -->
        <provider
            android:name=".saf.Z2TermDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
