<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 必須権限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Service（M3 で本格利用、M1 では宣言のみ） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ で永続通知に必須 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- バックグラウンド維持強化（M3 で利用） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- sshd 稼働中に Wi-Fi 無線の省電力 (PSM) を抑止して LAN 到達性を保つ WifiLock 用。
         これが無いと画面消灯/アイドルで Wi-Fi が省電力に入り、LAN からの着信が届かず
         「sshd を立てたのに繋がらない/繋ぎ直すと直る」症状が出る。 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 電池最適化からの除外要求 (L1: バックグラウンドでの kill 頻度低減)。
         Play 非配布アプリのため直接要求を許容する。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 端末起動時に常駐サーバー (sshd/http/smb 等) をアプリを開かず自動起動するため。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android API ブリッジ: z2-vibrate 用 (通常権限・実行時要求不要) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- SMS 受信検知 (汎用入口): 設定「SMS 検知」ON のとき、受信 SMS を ~/.z2term/sms.jsonl へ追記する。
         通知と違い SMS 本文は機微通知の伏せ字 (Android 15+) やロック状態の影響を受けないため、
         ワンタイムパスワードを確実に取れる。実行時許可制。 -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- RECEIVE_SMS は暗黙に「電話機能が必須」とみなされ、非電話端末 (タブレット/ChromeOS) から
         インストール不可になる。z2term はターミナルであり SMS 検知は任意機能なので、非電話端末でも
         入るよう required="false" を明示する (その端末では SMS 検知が発火しないだけ)。 -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- 端末から /sdcard (Android 共有ストレージ) を cd/読み書きするため。
         Android 11+ は全ファイルアクセス、〜10 は従来権限で対応。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:name=".Z2TermApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Z2Term"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="35">

        <!-- launchMode=singleTask: タブは 1 画面で持つものなので、外部 (共有シート) から
             呼ばれるたびに Activity が積み上がらないようにする。既に動いていれば
             onNewIntent で受け取る。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Z2Term">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 他アプリの共有シートからテキスト / ファイルを受け取る (B1)。
                 受け取った内容は端末の入力行に入れるだけで実行はしない。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- M8-4 で正式タブ統合済 (タブバーの 🖥 ボタンで GUI タブを開く)。
             この単独 Activity は debug 専用の検証ツールとして残置 (release では
             onCreate で即 finish)。exported=false にして外部 (adb am start 含む) からは
             起動できないようにした。アプリ内部から起動する用途のみ。 -->
        <activity
            android:name=".gui.GuiActivity"
            android:exported="false"
            android:label="z2term GUI"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode"
            android:theme="@style/Theme.Z2Term" />

        <!-- Terminal Foreground Service: バックグラウンドで PTY を維持 -->
        <service
            android:name=".service.TerminalService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="terminal_session_persistence" />
        </service>

        <!-- 常駐サーバー専用フォアグラウンドサービス: 対話セッションと独立して sshd/http/smb 等を常駐。 -->
        <service
            android:name=".service.ServerDaemonService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="server_daemon_persistence" />
        </service>

        <!-- システムイベント検知 (汎用入口): 設定「システムイベント検知」ON のとき常駐し、画面 ON/OFF・
             ロック解除・充電・電池・Wi‑Fi の各イベントを ~/.z2term/events.jsonl へ追記する。
             これらは暗黙ブロードキャスト制限で manifest レシーバでは拾えないため、生きた FG サービス内で
             動的レシーバを登録する。 -->
        <service
            android:name=".service.SystemEventService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="system_event_capture" />
        </service>

        <!-- 通知検知 (汎用入口): OS の「通知アクセス」許可を与えると Android が自動でバインド・常駐。
             設定「通知検知」ON のとき、受け取った通知を ~/.z2term/notifications.jsonl へ生ログ追記する。 -->
        <service
            android:name=".service.NotificationLogService"
            android:exported="false"
            android:label="@string/notif_capture_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 端末起動時の常駐サーバー自動起動レシーバ (設定 ON かつ enabled サーバーがある時のみ動く)。 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- z2-when (A6) 自動化ハブの充電/電池/時刻トリガーの受け口。ACTION_POWER_CONNECTED /
             _DISCONNECTED / BATTERY_LOW / _OKAY は暗黙ブロードキャスト制限の例外なので、専用の常駐
             サービス無しで (アプリ未起動でも) 拾える。いずれもシステム保護ブロードキャストなので
             exported=true でも外部アプリからは送れない。時刻発火 (WHEN_TIME_FIRE) は AlarmManager
             からの明示 Intent で届くのでフィルタは不要。 -->
        <receiver
            android:name=".service.WhenReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ホーム画面ウィジェット D1「状態＋ランチャー」。
             OS の定期更新 (APPWIDGET_UPDATE) と、ウィジェット内のボタンから送る自前の
             ブロードキャスト (REFRESH / RUN_MACRO) を受ける。後者は自アプリ内の明示 Intent
             なので exported=false のままで届く。ウィジェットの追加はランチャーが
             AppWidgetService 経由で行うため、こちらも公開不要。 -->
        <receiver
            android:name=".widget.StatusWidgetProvider"
            android:exported="false"
            android:label="@string/widget_status_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_status_info" />
        </receiver>

        <!-- 上のウィジェットの設定画面 (並べるマクロを選ぶ)。ウィジェット配置時にランチャーが
             起動するため exported=true が必須。受け取るのは appWidgetId だけ。 -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Z2Term">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- SMS 受信検知 (汎用入口): 設定「SMS 検知」ON かつ RECEIVE_SMS 許可があるとき、着信 SMS を
             ~/.z2term/sms.jsonl へ追記する。SMS_RECEIVED は暗黙ブロードキャスト制限の対象外なので
             manifest レシーバで拾える (アプリ未起動・ロック中でも起動)。BROADCAST_SMS でシステムからのみ届く。 -->
        <receiver
            android:name=".service.SmsLogReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 時刻トリガー (z2-alarm) の受け口。AlarmManager からのみ届くので exported=false。 -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:exported="false" />

        <!-- z2-notify のボタン応答の受け口。自アプリの PendingIntent からのみ届く。 -->
        <receiver
            android:name=".service.NotifyActionReceiver"
            android:exported="false" />

        <!-- ロック解除の失敗監視 (盗難対策マクロの検知入口): 端末管理者として有効化されると
             OS がロック解除の失敗/成功コールバックを届ける。宣言ポリシーは watch-login のみで
             遠隔ロック/ワイプはしない。BIND_DEVICE_ADMIN でシステムからのみバインド可。 -->
        <receiver
            android:name=".service.PasswordWatchAdmin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- SAF DocumentsProvider: rootfs / HOME を他のファイラーから開けるようにする。
             permission=MANAGE_DOCUMENTS でシステム (DocumentsUI) からのみアクセス可能。 -->
        <provider
            android:name=".saf.Z2TermDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
