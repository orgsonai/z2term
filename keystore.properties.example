# Z2Term リリース署名設定のテンプレート。
#
# 使い方:
#   1. このファイルを keystore.properties にコピー (実体は .gitignore 済み)
#   2. 下記 4 項目を自分のキーストアに合わせて編集
#   3. ./gradlew :app:assembleFossRelease  → 本番鍵で署名される
#
# keystore.properties が存在しない場合は debug 鍵にフォールバックする
# (app/build.gradle.kts の signingConfig 参照)。
#
# キーストア未作成なら以下で生成 (有効期限 ~27 年):
#   keytool -genkeypair -v \
#     -keystore z2term-release.jks \
#     -alias z2term \
#     -keyalg RSA -keysize 4096 -validity 10000

storeFile=z2term-release.jks
storePassword=CHANGE_ME
keyAlias=z2term
keyPassword=CHANGE_ME
